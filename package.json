{
  "name": "gmbovinos-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"yarn workspace @gmbovinos/web dev\" \"yarn workspace @gmbovinos/backend dev\"",
    "dev:web": "yarn workspace @gmbovinos/web dev",
    "dev:backend": "yarn workspace @gmbovinos/backend dev",
    "build": "yarn workspace @gmbovinos/shared build && yarn workspace @gmbovinos/backend build && yarn workspace @gmbovinos/web build",
    "generate": "yarn workspace @gmbovinos/web generate",
    "preview": "yarn workspace @gmbovinos/web preview",
    "lint": "yarn workspace @gmbovinos/web lint",
    "lint:fix": "yarn workspace @gmbovinos/web lint:fix",
    "format": "yarn workspace @gmbovinos/web format",
    "format:check": "yarn workspace @gmbovinos/web format:check",
    "db:generate": "yarn workspace @gmbovinos/backend db:generate",
    "db:migrate": "yarn workspace @gmbovinos/backend db:migrate",
    "db:seed": "yarn workspace @gmbovinos/backend db:seed",
    "postinstall": "yarn workspace @gmbovinos/shared build && yarn workspace @gmbovinos/web postinstall"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "resolutions": {
    "vue": "3.5.32",
    "@vue/compiler-core": "3.5.32",
    "@vue/compiler-dom": "3.5.32",
    "@vue/compiler-sfc": "3.5.32",
    "@vue/reactivity": "3.5.32",
    "@vue/runtime-core": "3.5.32",
    "@vue/runtime-dom": "3.5.32",
    "@vue/server-renderer": "3.5.32",
    "@vue/shared": "3.5.32"
  }
}
