# URL pública do site (canônico, Open Graph, sitemap). Ex.: https://www.gmbovinos.com.br
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=GM Bovinos

# API Express (CMS / leads / admin). Browser / CSP.
NUXT_PUBLIC_API_BASE=http://localhost:3001

# true em preview/staging: noindex + robots.txt bloqueia crawlers
NUXT_PUBLIC_NO_INDEX=false

# Local para título, meta, hero e schema (ex.: Minas Gerais)
NUXT_PUBLIC_SEO_LOCALITY=Minas Gerais

NUXT_PUBLIC_BUSINESS_ADDRESS=
NUXT_PUBLIC_BUSINESS_PHONE=
NUXT_PUBLIC_DEFAULT_OG_IMAGE=/media/photos/02.webp

NUXT_PUBLIC_WHATSAPP_NUMBER=
NUXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Gostaria de falar sobre compra ou venda de gado (e engorda/manejo, se precisar).
NUXT_PUBLIC_INSTAGRAM_URL=
NUXT_PUBLIC_FACEBOOK_URL=
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_FOUNDER_PROFILE_URL=
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
NUXT_PUBLIC_META_PIXEL_ID=

# Supabase Auth (admin) + Storage (galeria)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gallery

# Opcional: restringir e-mails admin (CSV). Vazio = qualquer usuário autenticado no Supabase.
# Em produção, prefira listar explicitamente (ex.: admin@gmbovinos.com.br).
# ADMIN_ALLOWED_EMAILS=
# ADMIN_REQUIRE_ROLE=false

# Postgres (local). Em produção use o pooler do Supabase — sem serviço `db` no Compose.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gmbovinos?schema=gmbovinos

# SMTP opcional (notificação ao criar contato no site)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO=

# --- Produção (Docker + Traefik + Supabase) — `.env` só na VPS ---
# DOMAIN=gmbovinos.com.br
# API_DOMAIN=api.gmbovinos.com.br
#
# Rede Docker do Traefik (bridge). Nunca use `host`.
# TRAEFIK_NETWORK=web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=gmbovinos
#
# Browser / CSP (HTTPS dos domínios reais — não localhost)
# NUXT_PUBLIC_API_BASE=https://api.gmbovinos.com.br
# NUXT_PUBLIC_SITE_URL=https://gmbovinos.com.br
#
# SSR (Compose): NUXT_API_BASE=http://gmbovinos-backend:3001
# Não usar http://backend:3001 — colide com outros apps na rede Traefik `web`.
