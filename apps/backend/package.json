{
  "name": "@gmbovinos/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prebuild": "yarn workspace @gmbovinos/shared build",
    "build": "prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js && mkdir -p dist/infrastructure/prisma/output && cp -a src/infrastructure/prisma/output/. dist/infrastructure/prisma/output/",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@gmbovinos/shared": "0.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "effect": "^3.21.2",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.6",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  }
}
