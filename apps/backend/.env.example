PORT=3001

# URL do Postgres (schema gmbovinos)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=gmbovinos

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gallery

# Vazio = qualquer usuário autenticado. Em produção, liste e-mails (CSV).
ADMIN_ALLOWED_EMAILS=
ADMIN_REQUIRE_ROLE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO=
